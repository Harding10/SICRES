# =============================================================================
# SICRES — Environnement Docker (copier vers .env et adapter les valeurs)
# =============================================================================
# ATTENTION : Ne jamais versionner le fichier .env réel (il est dans .gitignore)
# Ce fichier est un modèle sûr pour l'onboarding des développeurs.
# =============================================================================

# === APPLICATION ===
APP_NAME=SICRES
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# === PORTS EXPOSÉS (localhost → conteneur) ===
# Nginx (point d'entrée HTTP)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Frontend Next.js
FRONTEND_PORT=3000

# PostgreSQL (exposé uniquement en dev pour les IDE)
DB_PORT_EXPOSED=5432

# Redis (exposé uniquement en dev pour débogage)
REDIS_PORT_EXPOSED=6379

# Mailpit (UI de capture d'emails)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# pgAdmin (optionnel — lancé via `make pgadmin`)
PGADMIN_PORT=5050

# === BASE DE DONNÉES PostgreSQL ===
DB_DATABASE=sicres_db
DB_USERNAME=sicres_user
DB_PASSWORD=sicres_dev_password_2026

# === REDIS ===
REDIS_PASSWORD=sicres_redis_secret_2026

# === pgAdmin (interface graphique) ===
PGADMIN_EMAIL=admin@sicres.gouv.cm
PGADMIN_PASSWORD=admin_sicres_2026

# === XDEBUG (développement) ===
# Adresse IP de votre machine hôte (pour que Xdebug la rejoigne)
# Linux : 172.17.0.1 | Mac : host.docker.internal | Windows : host.docker.internal
XDEBUG_CLIENT_HOST=172.17.0.1
XDEBUG_CLIENT_PORT=9003
